conky.config = {
    background = false,
    update_interval = 60,
    double_buffer = true,
    no_buffers = true,
    text_buffer_size = 4096,

    own_window = true,
    own_window_type = 'normal',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_title = 'MARKETS',
    own_window_argb_visual = true,
    own_window_argb_value = 0,
    own_window_transparent = true,

    -- Centre of the primary monitor, under the Gotham clock.
    alignment = 'top_middle',
    gap_x = 0,
    gap_y = 330,
    minimum_width = 480,
    maximum_width = 480,
    -- Conky sizes rows with the Ubuntu font; the DejaVu Mono sparklines make them taller.
    minimum_height = 200,

    draw_shades = false,
    draw_outline = false,
    draw_borders = false,
    draw_graph_borders = false,

    use_xft = true,
    font = 'Ubuntu:size=9',
    override_utf8_locale = true,
    default_color = 'EAEAEA',
};

conky.text = [[
${font GE Inspira:pixelsize=22}${color FFA300}MARKETS${font}${voffset -4}${color 666666}${hr 1}
${voffset 4}${execpi 900 ~/.conky/market.sh}
]];
