conky.config = {
--==============================================================================
-- 2020/01/04
-- this is for conky version 1.1
-- converted by me using lua convert tool
--
--                               conkyrc_orange

--  author  : AA
--  version : v001
--  license : Distributed under the terms of GNU GPL version 2 or later
--  modified: me
--  notes   : works on 4k screen. uses conky conf newer >v1.1

--==============================================================================

	background = true,
	update_interval = 1,

	cpu_avg_samples = 2,
	net_avg_samples = 2,
	temperature_unit = 'celsius',

	double_buffer = true,
	no_buffers = true,
	text_buffer_size = 2048,

	gap_x = 100,
	gap_y = 0,
	minimum_width = 600,
	minimum_height = 450,
	maximum_width = 600,
	own_window = true,
--## me change, added next 2 lines
--## own_window_type override
	own_window_type = 'normal',
	own_window_argb_visual = true,
	own_window_transparent = true,
	own_window_hints = 'undecorated,sticky,skip_taskbar,skip_pager,below',
	border_inner_margin = 0,
	border_outer_margin = 0,
	alignment = 'top_right',

	draw_shades = false,
	draw_outline = false,
	draw_borders = false,
	draw_graph_borders = false,

	override_utf8_locale = true,
	use_xft = true,
	font = 'Ubuntu:size=7',
	xftalpha = 0.5,
	uppercase = false,

	default_color = '#FFFFFF',
	color1 = '#DDDDDD',
	color2 = '#AAAAAA',
	color3 = '#888888',
	color4 = '#EF5A29',

	lua_load = '/home/albandrieu/.conky/ConkyOrange/conky_orange_4k.lua',
	lua_draw_hook_post = 'main',

};

